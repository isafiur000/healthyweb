' Gambas class file

Private $sDevice As String
Private $sValue As String

Public Sub Run(sDevice As String) As String

  $sDevice = sDevice
  modGeneralMain.GetOpenModalForm(Me)
  mnupload_Click()

  If Me.ShowModal() Then Return $sValue

End

Public Sub mnupload_Click()

  Dim sfile As String

  sfile = File.Load("jv/qr-scanner.js")
  Me.Exec(sfile)

End

Public Sub btnsave_Click()

  Dim asx As String

  WebTextBox1.SetFocus
  asx = "qrvalue = " & "$_(" & JS(WebLabel1.Name) & ").innerHTML;"
  asx = asx & "$_(" & JS(WebTextBox1.Name & ":entry") & ").value = qrvalue;"
  asx = asx & " gw.update(" & JS(WebTextBox1.Name) & ", 'text', qrvalue);"
  Me.Exec(asx)

End

Public Sub btnclose_Click()

  If WebTextBox1.Text Then
    $sValue = WebTextBox1.Text
    Me.Close(True)
  Else
    Me.Close()
  Endif

End
