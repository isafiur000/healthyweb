Private Sub UnivariateDataView()

  Dim xx As String
  Dim xField As String
  Dim Column As Integer
  Dim res As Result
  Dim xval As Variant
  Dim hFile As CUnivariate
  Dim sOrder As String[]
  Dim xFldList As String[]

  Dim hUniv As FmAnalyzeSett

  hUniv = New FmAnalyzeSett("Univariate", modGridView.GetGridViewColumns(GridView2))
  hUniv.ShowModal

  hFile = New CUnivariate
  xFldList = GetDataViewColumns()
  Column = modCustPatient.GetUnivariateColumn(0)
  xField = xFldList[Column]
  res = ExecuteQuery([xField], "GROUP BY")

  If res.Available Then
    For Each res
      xval = GetDataViewValue(Column, res[xField])
      If xval Then
        hFile.Add(xval)
      Endif
    Next
  Endif

  If modSettings.ShowSettingFromFIle("UnivariateAnalysis/DataType") = "Ordinal" Then
    sOrder = ListOrder("Select Order", hFile.DistinctValues())
  Endif
  xx = modPSPP.GetEncChartGridNew(hFile.GetSPSSFile(), sOrder)
  If xx Then
    modControlSub.OpenBrowser(xx)
  Endif

End

