' Gambas class file

Private $encid As String
Private $sIndex As String
Private $strUnit As String
Private $sTable As String

Private res As Result

Public Sub _new(encid As String, sIndex As Long, strUnit As String, Optional sTable As String)

  $encid = encid
  $sIndex = sIndex
  $strUnit = strUnit
  If sTable Then
    $sTable = sTable
  Else
    $sTable = "tblpatlabtest"
  Endif
  LoadQuery()

End

Private Sub LoadQuery()

  Dim sFldLst As String[]

  sFldLst = ["fldid", "fldencounterval", "fldtestid", "fldmethod", "fldgroupid", "fldsampleid", "fldsampletype", "fldreportquali", "fldreportquanti", "fldabnormal", "fldtestunit", "fldstatus", "fldcondition", "fldcomment", "flvisible", "fldtest_type", "flduserid_sample", "fldtime_sample", "fldcomp_sample", "flduserid_report", "fldtime_report", "fldcomp_report", "flduserid_verify", "fldtime_verify", "fldcomp_verify"]
  res = modDatabase.$myConn.Exec("select " & sFldLst.Join(",") & " from " & $sTable & " where fldid=&1 and fldencounterval=&2", $sIndex, $encid)

End
