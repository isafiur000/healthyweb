# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,94,49)
  Class = "size-popupform"
  Arrangement = Arrange.Vertical
  Margin = True
  Title = ("ICD Database")
  { WebContainer1 WebContainer
    #MoveScaled(1,1,92,5)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { chkleftmain WebCheckBox
      #MoveScaled(1,1,5,3)
      Height = "2em"
    }
    { txtname WebTextBox
      #MoveScaled(6,1,20,3)
      Width = "10em"
      Height = "2em"
      ShowClear = True
    }
    { btnsemantic WebButton
      #MoveScaled(26,1,3,3)
      Width = "3em"
      Height = "2em"
      Visible = False
      Image = "icon:/32/right"
    }
    { WebContainer7 WebContainer
      #MoveScaled(29,1,6,3)
      Expand = True
    }
    { btninsert WebButton
      #MoveScaled(35,1,12,3)
      Width = "6em"
      Height = "2em"
      Text = ("Select")
    }
    { btnok WebButton
      #MoveScaled(47,1,12,3)
      Width = "6em"
      Height = "2em"
      Text = ("Save")
      Image = "icon:/32/apply"
      Default = True
    }
    { WebContainer3 WebContainer
      #MoveScaled(59,1,6,3)
      Expand = True
    }
    { txtcode WebTextBox
      #MoveScaled(65,1,9,3)
      Width = "6em"
      Height = "2em"
    }
  }
  { WebContainer2 WebContainer
    #MoveScaled(1,6,92,33.875)
    Height = "50vh"
    Expand = True
    Arrangement = Arrange.Horizontal
    { GridView1 WebTable
      #MoveScaled(1,1,41,31.875)
      Expand = True
      Mode = Select.Multiple
    }
  }
  { WebContainer4 WebContainer
    #MoveScaled(1,39.875,92,4)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { chkboth WebCheckBox
      #MoveScaled(1,1,17,2)
      Height = "2em"
      Text = ("Both Coding")
    }
    { WebContainer5 WebContainer
      #MoveScaled(18,1,3,2)
      Expand = True
    }
    { chkgroup WebCheckBox
      #MoveScaled(21,1,14,2)
      Height = "2em"
      Text = ("Groups Only")
    }
    { WebContainer8 WebContainer
      #MoveScaled(35,1,3,2)
      Expand = True
    }
    { chksemantic WebCheckBox
      #MoveScaled(38,1,14,2)
      Height = "2em"
      Text = ("Semantic Search")
    }
    { WebContainer10 WebContainer
      #MoveScaled(52,1,3,2)
      Expand = True
    }
    { chkall WebCheckBox
      #MoveScaled(55,1,14,2)
      Height = "2em"
      Text = ("Select All")
    }
    { WebContainer6 WebContainer
      #MoveScaled(69,1,3,2)
      Expand = True
    }
    { btnclose WebButton
      #MoveScaled(72,1,8,2)
      Width = "5em"
      Height = "2em"
      Text = ("Close")
      Cancel = True
    }
  }
}
