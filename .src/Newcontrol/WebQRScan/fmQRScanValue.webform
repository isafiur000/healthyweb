# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,64,47)
  Class = "size-popupform"
  Expand = True
  Arrangement = Arrange.Vertical
  Margin = True
  Title = ("QR Code Scanner")
  { WebMenu1 WebMenu
    Visible = False
    { mnupload WebMenu
      Text = ("Upload")
    }
  }
  { WebContainer1 WebContainer
    #MoveScaled(1,1,62,5)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { btnstart WebButton
      #MoveScaled(1,1,14,3)
      Class = "startBtn"
      Width = "10em"
      Height = "2em"
      Text = ("Start")
    }
    { WebLabel2 WebLabel
      #MoveScaled(15,1,14,3)
      Class = "status-text"
      Expand = True
      Alignment = Align.Center
      Border = True
    }
    { btnstop WebButton
      #MoveScaled(29,1,6,3)
      Class = "stopBtn"
      Width = "3em"
      Height = "2em"
      Image = "icon:/32/stop"
    }
    { btnclear WebButton
      #MoveScaled(35,1,6,3)
      Class = "clearBtn"
      Width = "3em"
      Height = "2em"
      Image = "icon:/32/clear"
    }
  }
  { WebContainer2 WebContainer
    #MoveScaled(1,6,62,5)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { WebLabel1 WebLabel
      #MoveScaled(1,1,9,3)
      Class = "qr-result"
      Height = "2em"
      Expand = True
      Border = True
    }
    { btncopy WebButton
      #MoveScaled(10,1,4,3)
      Class = "copyBtn"
      Width = "2em"
      Height = "2em"
      Image = "icon:/32/copy"
    }
    { WebContainer4 WebContainer
      #MoveScaled(14,1,3,3)
      Expand = True
    }
    { WebTextBox1 WebTextBox
      #MoveScaled(17,1,14,3)
      Height = "2em"
      Expand = True
    }
    { btnsave WebButton
      #MoveScaled(31,1,9,3)
      Width = "6em"
      Text = ("Save")
    }
    { btnclose WebButton
      #MoveScaled(40,1,9,3)
      Width = "6em"
      Text = ("Close")
    }
  }
  { WebRecVideo1 WebRecVideo
    #MoveScaled(1,11,62,19)
    Class = "qr-video"
    Height = "15em"
    State = "playsinline muted"
  }
  { WebContainer3 WebContainer
    #MoveScaled(1,30,62,7)
  }
}
