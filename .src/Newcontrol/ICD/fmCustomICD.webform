# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,71,91)
  Arrangement = Arrange.Vertical
  Margin = True
  Title = ("Custom ICD Diagnosis")
  { WebContainer1 WebContainer
    #MoveScaled(1,1,69,63)
    Class = "size-popupform"
    Arrangement = Arrange.Vertical
    { WebContainer2 WebContainer
      #MoveScaled(1,1,67,5)
      Class = "less-container-margin"
      Arrangement = Arrange.Horizontal
      { txtname WebTextBox
        #MoveScaled(1,1,24,3)
        Height = "2em"
        Expand = True
        ShowClear = True
      }
      { btnload WebButton
        #MoveScaled(25,1,12,3)
        Width = "4em"
        Height = "2em"
        Text = ("Load")
      }
      { btnsave WebButton
        #MoveScaled(37,1,12,3)
        Width = "6em"
        Height = "2em"
        Text = ("Save")
        Image = "icon:/32/apply"
        Cancel = True
      }
    }
    { GridView1 WebTable
      #MoveScaled(1,6,67,18)
      Height = "30vh"
      Mode = Select.Single
      ShowCheck = False
    }
    { WebContainer3 WebContainer
      #MoveScaled(1,24,67,5)
      Class = "less-container-margin"
      Arrangement = Arrange.Horizontal
      { chkusecustom WebCheckBox
        #MoveScaled(1,1,18,3)
        Height = "2em"
        Text = ("Use Custom Text")
      }
    }
  }
}
