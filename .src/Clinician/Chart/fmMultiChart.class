' Gambas class file

Private aPanel As New Object[100]
Private aObj As New Object[100]
Private aObk As New Object[100]
Private aObLef As New Object[100]
Private aObRig As New Object[100]
Private aObjx As New Object[100]
Private aObj1 As New Object[100]
Private aObHBox As New Object[100]
Private aObVal As New Object[100]
Private aObBox As New Object[100]
Private aObTxt As New Object[100]
Private aObBtn As New Object[100]
Private aObButt As New Object[100]

Private $encid As String
Private $sTitle As String
Private $xParamVar As Variant[]
Private $xalllow As Boolean
Private $hasInfusion As Boolean

Private $chartColl As Collection
Private $unt As String
Private AppFactor As Float
Private $UserRestrict As String[]
Private $PatientNum As String
Private $status As String
Private $input As Boolean

Private $xfir As Date
Private $xlast As Date

Public Sub _new(encid As String, sTitle As String, unt As String)

  $encid = encid
  $sTitle = sTitle
  $unt = unt
  modGeneralMain.GetOpenModalForm(Me)

  Me.Title = "ENCID: " & $encid
  txtpatientname.Text = modPatient.GetPatientNameByEnc($encid)
  $PatientNum = modPatient.GetPatientNoByEnc($encid)
  txtlocation.Text = modPatient.GetPatientLocation($encid)
  $status = modPatient.CurrentAdmissionStatus($encid)
  $xalllow = modPatient.EnableClinicForm($status)
  $input = modPatient.EnableClinicForm($status)
  $UserRestrict = modBasic.$ClinicDisableCompo

  modBasic.LoadClinicalChartSetting()
  AppFactor = modBasic.$AppScaleFactor
  GetVariables()

  rbhour.Value = True
  rboneday.Value = True

End

Private Sub GetVariables()

  Dim res As Result
  Dim sColl As Collection

  Dim aColl As Collection
  Dim xList As String

  $hasInfusion = False
  $xParamVar = New Variant[]
  If $sTitle = "Essential Examinations" Then
    For Each aColl In modTableCache.$ExaminationCompVar
      If aColl["fldcategory"] = "Essential Examinations" Then
        sColl = New Collection
        sColl.Add("Examination", "Category")
        sColl.Add(aColl["fldexamid"], "Examination")
        sColl.Add("", "Component")
        sColl.Add(aColl["fldtype"], "Type")
        sColl.Add("", "Comment")
        sColl.Add(aColl["fldsysconst"], "Constant")
        sColl.Add(aColl["fldtanswertype"], "Option")
        If aColl["fldtype"] = "Qualitative" And If aColl["fldsysconst"] Then
          xList = modAllExam.SelectExamOptionList("Exam", aColl["fldexamid"]).join(";")
          sColl.Add(xList, "OptionValues")
        Else
          sColl.Add("", "OptionValues")
        Endif
        $xParamVar.Add(sColl)
      Endif
    Next

  Else
    res = modDatabase.$myConn.Exec("select fldcategory,fldexam,fldsubexam,fldtype,fldcomment,fldsysconst,fldoption,fldselection from tbldepartchart where fldtitle=&1 and (fldcomp=&2 or fldcomp=&3) ORDER BY fldexamorder", $sTitle, modBasic.$compID, "%")
    If res.Available Then
      For Each res
        If res["fldcategory"] = "Intake" And If res["fldexam"] = "Infusion" Then
          $hasInfusion = True
        Endif

        sColl = New Collection
        sColl.Add(res["fldcategory"], "Category")
        sColl.Add(res["fldexam"], "Examination")
        sColl.Add(res["fldsubexam"], "Component")
        sColl.Add(res["fldtype"], "Type")
        sColl.Add(res["fldcomment"], "Comment")
        sColl.Add(res["fldsysconst"], "Constant")
        sColl.Add(res["fldoption"], "Option")
        If res["fldtype"] = "Qualitative" And If res["fldsysconst"] Then
          If res["fldcategory"] = "Examination" Then

            If res["fldsubexam"] Then
              If res["fldoption"] = "Clinical Scale" Then
                xList = modAllExam.GetCLinicalScaleCategoryOptions("Exam", res["fldexam"], res["fldsubexam"]).join(";")
              Endif
            Else
              xList = modAllExam.SelectExamOptionList("Exam", res["fldexam"], res["fldoption"]).join(";")
            Endif
            sColl.Add(xList, "OptionValues")

          Else
            sColl.Add("", "OptionValues")
          Endif
        Else
          sColl.Add(res["fldselection"], "OptionValues")
        Endif
        $xParamVar.Add(sColl)
      Next
    Endif

  Endif

End

''======================= Tables =============================================
Public Sub btnshowtables_Click()

  LoadTablesExam()

End

Private Function GetDateRange(xfir As Date, colm As Integer) As Date

  Dim dtrange As Date

  If rbminute.Value = True Then
    dtrange = DateAdd(xfir, gb.Minute, colm * 10)
  Else If rbhour.Value = True Then
    dtrange = DateAdd(xfir, gb.Hour, colm)
  Else If rbdaily.Value = True Then
    dtrange = DateAdd(xfir, gb.Day, colm)
  Else If rbmonth.Value = True Then
    dtrange = DateAdd(xfir, gb.Month, colm)
  Endif

  Return dtrange

End

Private Sub GetInfusionItemList(patNo As String, xStart As Date, xLast As Date)

  Dim sql1 As String
  Dim sql2 As String
  Dim res As Result
  Dim sColl As Collection
  Dim i As Integer
  Dim xcol As Integer

  For i = 0 To $xParamVar.Count - 1
    If $xParamVar[i]["Category"] = "Intake" And If $xParamVar[i]["Examination"] = "Infusion" Then
      xcol = i + 1
      Break
    Endif
  Next

  If xcol Then
    $xParamVar.Remove(xcol - 1)
  Endif

  sql1 = "select DISTINCT(tblnurdosing.fldmedicine) as fldmedicine from tblnurdosing inner join tblencounter on tblnurdosing.fldencounterval=tblencounter.fldencounterval where tblencounter.fldpatientval=&1 and tblnurdosing.fldsave=&2 and tblnurdosing.fldfromtime<&3 and (tblnurdosing.fldtotime IS NULL or tblnurdosing.fldtotime>&4) and flddoseno in(select fldid from tblpatdosing where fldroute=&5 or fldroute=&6 or fldroute=&7)"
  sql2 = "select DISTINCT(tblnurdosing.fldmedicine) as fldmedicine from tblnurdosing inner join tblencounter on tblnurdosing.fldencounterval=tblencounter.fldencounterval where tblencounter.fldpatientval=&1 and tblnurdosing.fldsave=&2 and tblnurdosing.fldfromtime<&3 and (tblnurdosing.fldtotime IS NULL or tblnurdosing.fldtotime>&4) and fldcardex in(select fldid from tblinpatdosing where fldroute=&5 or fldroute=&6 or fldroute=&7)"
  res = modDatabase.$myConn.Exec(sql1 & " UNION " & sql2, patNo, True, xLast, xStart, "fluid", "IIV", "CIV")
  If res.Available Then
    For Each res
      sColl = New Collection
      sColl.Add("Intake", "Category")
      sColl.Add("Infusion", "Examination")
      sColl.Add(modMedConstant.GetDrugFromStockID(res["fldmedicine"]), "Component")
      sColl.Add(res["fldmedicine"], "Constant")
      $xParamVar.Add(sColl)
    Next
  Endif

End

Private Sub LoadTablesExam()

  Dim j As Integer
  Dim xdiff As Integer

  xdiff = 0 - spncolumn.Value
  GridView2.Clear()
  If rbminute.Value = True Then
    $xfir = modDate.StartSqlTenMinute(DateAdd(Now(), gb.Minute, xdiff * 10))
    $xlast = modDate.StartSqlTenMinute(DateAdd(Now(), gb.Minute, 10))
    GridView2.Columns.Count = (DateDiff($xfir, $xlast, gb.Minute) / 10) + 1
  Else If rbhour.Value = True Then
    $xfir = modDate.StartSqlHour(DateAdd(Now(), gb.Hour, xdiff))
    $xlast = modDate.StartSqlHour(DateAdd(Now(), gb.Hour, 1))
    GridView2.Columns.Count = DateDiff($xfir, $xlast, gb.Hour) + 1
  Else If rbdaily.Value = True Then
    $xfir = modDate.StartSqlDate(DateAdd(Now(), gb.Day, xdiff))
    $xlast = modDate.StartSqlDate(DateAdd(Now(), gb.Day, 1))
    GridView2.Columns.Count = DateDiff($xfir, $xlast, gb.Day) + 1
  Else If rbmonth.Value = True Then
    $xfir = modDate.StartSqlMonth(DateAdd(Now(), gb.Month, xdiff))
    $xlast = modDate.StartSqlMonth(DateAdd(Now(), gb.Month, 1))
    GridView2.Columns.Count = DateDiff($xfir, $xlast, gb.Month) + 1
  Endif
  If $hasInfusion = True Then
    GetInfusionItemList($PatientNum, $xfir, $xlast)
    $hasInfusion = False
  Endif
  GridView2.Count = $xParamVar.Count

  With GridView2
    For j = 0 To GridView2.Columns.Count - 1
      If j = 0 Then
        .Columns[j].Width = CStr(200 * modBasic.$AppWidthRatio) & "px"
        .Columns[j].Text = "Examination"
      Else If j = 1 Then
        If chkcomment.Value = True Then
          .Columns[j].Width = CStr(100 * modBasic.$AppWidthRatio) & "px"
          .Columns[j].Text = "Comment"
        Else
          .Columns[j].Hidden = True
        Endif
      Else
        .Columns[j].Width = CStr(64 * modBasic.$AppWidthRatio) & "px"
        If rbminute.Value = True Then
          .Columns[j].Text = modReportVar.GetDateTimeReport(GetDateRange($xfir, j), gb.ShortTime)
        Else If rbhour.Value = True Then
          .Columns[j].Text = modReportVar.GetDateTimeReport(GetDateRange($xfir, j), gb.ShortTime)
        Else If rbdaily.Value = True Then
          .Columns[j].Text = modDate.GetDateOnlyInFormatForAll(GetDateRange($xfir, j), modBasic.$DateFormat, "DateOnly")
        Else If rbmonth.Value = True Then
          .Columns[j].Text = modDate.GetDateOnlyInFormatForAll(GetDateRange($xfir, j), modBasic.$DateFormat, "YearMonth")
        Endif
      Endif
    Next
  End With

End

Public Sub GridView2_Data(Row As Integer, Column As Integer, Data As WebTableData)

  modGridView.GridViewDecoration(Data, Row)
  If Column = 0 Then
    If $xParamVar[Row]["Component"] Then
      Data.Text = $xParamVar[Row]["Component"] & " [" & $xParamVar[Row]["Examination"] & "]"
    Else
      Data.Text = $xParamVar[Row]["Examination"]
    Endif
  Else If Column = 1 Then
    Data.Text = $xParamVar[Row]["Comment"]
  Else

    If $xParamVar[Row]["Category"] = "Examination" Then
      Data.Text = GetExamValueByDate($PatientNum, $xParamVar[Row], GetDateRange($xfir, Column))
    Else If $xParamVar[Row]["Category"] = "Laboratory" Then
      Data.Text = GetLabValueByDate($PatientNum, $xParamVar[Row], GetDateRange($xfir, Column))
    Else If $xParamVar[Row]["Category"] = "Medicines" Then
      Data.Text = GetMedicineDoseByDate($PatientNum, $xParamVar[Row], GetDateRange($xfir, Column))
    Else If $xParamVar[Row]["Category"] = "Intake" Then
      Data.Text = GetIntakeVolumeByDate($PatientNum, $xParamVar[Row], GetDateRange($xfir, Column))
    Else If $xParamVar[Row]["Category"] = "Output" Then
      Data.Text = GetOutputVolByDate($PatientNum, $xParamVar[Row], GetDateRange($xfir, Column))
    Endif

  Endif

End

Private Function GetFirstDate(xDate As Date) As Date

  Dim xfir As Date

  If rbminute.Value = True Then
    xfir = modDate.StartSqlTenMinute(xDate)
  Else If rbhour.Value = True Then
    xfir = modDate.StartSqlHour(xDate)
  Else If rbdaily.Value = True Then
    xfir = modDate.StartSqlDate(xDate)
  Else If rbmonth.Value = True Then
    xfir = modDate.StartSqlMonth(xDate)
  Endif

  Return xfir

End

Private Function GetLastDate(xDate As Date) As Date

  Dim xlast As Date

  If rbminute.Value = True Then
    xlast = modDate.EndSqlTenMinute(xDate)
  Else If rbhour.Value = True Then
    xlast = modDate.EndSqlHour(xDate)
  Else If rbdaily.Value = True Then
    xlast = modDate.EndSqlDate(xDate)
  Else If rbmonth.Value = True Then
    xlast = modDate.EndSqlMonth(xDate)
  Endif

  Return xlast

End

''-------------------------- SUM value -----------------------------
Private Function GetIntakeVolumeByDate(patNo As String, xColl As Collection, xDate As Date) As String

  Dim xfir As Date
  Dim xlast As Date
  Dim xx As String

  xfir = GetFirstDate(xDate)
  xlast = GetLastDate(xDate)

  If xColl["Examination"] = "Oral/NGT" Then
    xx = OralIntakeVolByDate(patNo, xfir, xlast)
  Else If xColl["Examination"] = "Infusion" Then
    xx = InfusionEstimateVolByDate(patNo, xColl["Constant"], xfir, xlast)
  Else If xColl["Examination"] = "Injections" Then
    xx = InjectionIntakeVolByDate(patNo, xfir, xlast)
  Endif

  Return xx

End

Private Function OralIntakeVolByDate(patNo As String, xfir As Date, xlast As Date) As String

  Dim res As Result
  Dim xx As String

  res = modDatabase.$myConn.Exec("select SUM(tblexamgeneral.fldreportquanti) as fldvalue from tblexamgeneral inner join tblencounter on tblexamgeneral.fldencounterval=tblencounter.fldencounterval where tblencounter.fldpatientval=&1 and tblexamgeneral.fldsave=&2 and tblexamgeneral.fldinput=&3 and tblexamgeneral.fldtime>=&4 and tblexamgeneral.fldtime<=&5 ORDER BY tblexamgeneral.fldtime", patNo, True, "Input Food/Fluid", xfir, xlast)
  If res.Available Then
    res.MoveLast
    xx = res["fldvalue"]
  Else
    xx = ""
  Endif

  Return xx

End

Private Function InjectionIntakeVolByDate(patNo As String, xfir As Date, xlast As Date) As String

End

Private Function InfusionEstimateVolByDate(patNo As String, xMedicine As String, xfir As Date, xlast As Date) As String

  Dim res As Result
  Dim xvol As Float
  Dim xx As String
  Dim xstart As Date
  Dim xend As Date

  If xfir > Now() And If xlast > Now() Then
    xx = ""
  Else
    xvol = 0
    res = modDatabase.$myConn.Exec("select tblnurdosing.fldvalue as fldvalue,tblnurdosing.fldfromtime as fldfromtime,tblnurdosing.fldtotime as fldtotime from tblnurdosing inner join tblencounter on tblnurdosing.fldencounterval=tblencounter.fldencounterval where tblencounter.fldpatientval=&1 and tblnurdosing.fldsave=&2 and tblnurdosing.fldfromtime<&3 and (tblnurdosing.fldtotime IS NULL or tblnurdosing.fldtotime>&4) and tblnurdosing.fldmedicine=&5", patNo, True, xlast, xfir, xMedicine)
    If res.Available Then
      For Each res
        If res["fldfromtime"] <= xfir Then
          xstart = xfir
        Else
          xstart = res["fldfromtime"]
        Endif

        If res["fldtotime"] Then
          If res["fldtotime"] >= xlast Then
            xend = xlast
          Else
            xend = res["fldtotime"]
          Endif
        Else
          xend = xlast
        Endif
        If xend > Now() Then
          xend = Now()
        Endif

        xvol = xvol + Round(DateDiff(xstart, xend, gb.Minute) * res["fldvalue"] / 60, 0)
      Next
      xx = CStr(xvol)
    Else
      xx = ""
    Endif
  Endif

  Return xx

End

Private Function GetOutputVolByDate(patNo As String, xColl As Collection, xDate As Date) As String

  Dim res As Result
  Dim xx As String
  Dim xfir As Date
  Dim xlast As Date

  xfir = GetFirstDate(xDate)
  xlast = GetLastDate(xDate)

  res = modDatabase.$myConn.Exec("select SUM(tblexamgeneral.fldreportquanti) as fldvalue from tblexamgeneral inner join tblencounter on tblexamgeneral.fldencounterval=tblencounter.fldencounterval where tblencounter.fldpatientval=&1 and tblexamgeneral.flditem=&2 and tblexamgeneral.fldinput=&3 and tblexamgeneral.fldtime>=&4 and tblexamgeneral.fldtime<=&5 ORDER BY tblexamgeneral.fldtime", patNo, xColl["Examination"], "Output Fluid", xfir, xlast)
  If res.Available Then
    res.MoveLast
    xx = res["fldvalue"]
  Else
    xx = ""
  Endif

  Return xx

End

Private Function GetMedicineDoseByDate(patNo As String, xColl As Collection, xDate As Date) As String

  Dim res As Result
  Dim xx As String
  Dim xfir As Date
  Dim xlast As Date

  xfir = GetFirstDate(xDate)
  xlast = GetLastDate(xDate)

  res = modDatabase.$myConn.Exec("select SUM(tblnurdosing.fldvalue) as fldvalue,tblnurdosing.fldmedicine as fldmedicine from tblnurdosing inner join tblencounter on tblnurdosing.fldencounterval=tblencounter.fldencounterval where tblencounter.fldpatientval=&1 and tblnurdosing.fldmedicine in(select fldbrandid from tblmedbrand where flddrug=&2) and tblnurdosing.fldtime>=&3 and tblnurdosing.fldtime<=&4 ORDER BY tblnurdosing.fldtime", patNo, xColl["Examination"], xfir, xlast)
  If res.Available Then
    res.MoveLast
    xx = res["fldvalue"] * modMedConstant.GetDrugInitialStrength(res["fldmedicine"])
  Else
    xx = ""
  Endif

  Return xx

End

''--------------------- Last Values ----------------------------------
Private Function GetLabValueByDate(patNo As String, xColl As Collection, xDate As Date) As String

  Dim res As Result
  Dim xx As String
  Dim xfir As Date
  Dim xlast As Date

  xfir = GetFirstDate(xDate)
  xlast = GetLastDate(xDate)

  If xColl["Component"] Then
    res = modDatabase.$myConn.Exec("select tblpatlabsubtest.fldreport as fldreport from (tblpatlabsubtest inner join tblpatlabtest on (tblpatlabtest.fldid=tblpatlabsubtest.fldtestid and tblpatlabtest.fldencounterval=tblpatlabsubtest.fldencounterval)) inner join tblencounter on tblpatlabtest.fldencounterval=tblencounter.fldencounterval  where tblencounter.fldpatientval=&1 and tblpatlabtest.fldsave_report=&2 and tblpatlabtest.fldtestid=&3 and tblpatlabsubtest.fldsubtest=&4 and tblpatlabtest.fldtime_sample>=&5 and tblpatlabtest.fldtime_sample<=&6 ORDER BY tblpatlabtest.fldtime_sample", patNo, True, xColl["Examination"], xColl["Component"], xfir, xlast)         ''
    If res.Available Then
      res.MoveLast
      If res["fldreport"] Then
        xx = res["fldreport"]
      Else
        xx = ""
      Endif
    Else
      xx = ""
    Endif

  Else
    res = modDatabase.$myConn.Exec("select tblpatlabtest.fldreportquali as fldreportquali,tblpatlabtest.fldreportquanti as fldreportquanti from tblpatlabtest inner join tblencounter on tblpatlabtest.fldencounterval=tblencounter.fldencounterval  where tblencounter.fldpatientval=&1 and tblpatlabtest.fldsave_report=&2 and tblpatlabtest.fldtestid=&3 and tblpatlabtest.fldtime_sample>=&4 and tblpatlabtest.fldtime_sample<=&5 ORDER BY tblpatlabtest.fldtime_sample", patNo, True, xColl["Examination"], xfir, xlast)
    If res.Available Then
      res.MoveLast
      If res["fldreportquanti"] Then
        xx = CStr(res["fldreportquanti"])
      Else
        xx = res["fldreportquali"]
      Endif
    Else
      xx = ""
    Endif

  Endif
  Return xx

End

Private Function GetExamValueByDate(patNo As String, xColl As Collection, xDate As Date) As String

  Dim res As Result
  Dim res1 As Result
  Dim xx As String
  Dim xfir As Date
  Dim xlast As Date

  xfir = GetFirstDate(xDate)
  xlast = GetLastDate(xDate)

  If xColl["Component"] Then
    If xColl["Option"] = "Clinical Scale" Then
      res = modDatabase.$myConn.Exec("select tblpatientexam.fldrepquali as fldrepquali,tblpatientexam.fldrepquanti as fldrepquanti from tblpatientexam inner join tblencounter on tblpatientexam.fldencounterval=tblencounter.fldencounterval  where tblencounter.fldpatientval=&1 and tblpatientexam.fldsave=&2 and tblpatientexam.fldhead=&3 and tblpatientexam.fldtime>=&4 and tblpatientexam.fldtime<=&5 ORDER BY tblpatientexam.fldtime", patNo, True, xColl["Component"] & " [" & xColl["Examination"] & "]", xfir, xlast)
      If res.Available Then
        res.MoveLast
        If res["fldrepquanti"] Then
          xx = CStr(res["fldrepquanti"])
        Endif
      Endif

      If Not xx Then
        res1 = modDatabase.$myConn.Exec("select tblpatientsubexam.fldreport as fldreport from (tblpatientsubexam inner join tblpatientexam  on (tblpatientexam.fldid=tblpatientsubexam.fldheadid and tblpatientexam.fldencounterval=tblpatientsubexam.fldencounterval)) inner join tblencounter on tblpatientexam.fldencounterval=tblencounter.fldencounterval  where tblencounter.fldpatientval=&1 and tblpatientexam.fldsave=&2 and tblpatientexam.fldhead=&3 and tblpatientsubexam.fldsubtexam=&4 and tblpatientexam.fldtime>=&5 and tblpatientexam.fldtime<=&6 ORDER BY tblpatientexam.fldtime", patNo, True, xColl["Examination"], xColl["Component"], xfir, xlast)
        If res1.Available Then
          res1.MoveLast
          If res1["fldreport"] Then
            xx = res1["fldreport"]
          Else
            xx = ""
          Endif
        Else
          xx = ""
        Endif
      Endif

    Else
      res1 = modDatabase.$myConn.Exec("select tblpatientsubexam.fldreport as fldreport from (tblpatientsubexam inner join tblpatientexam  on (tblpatientexam.fldid=tblpatientsubexam.fldheadid and tblpatientexam.fldencounterval=tblpatientsubexam.fldencounterval)) inner join tblencounter on tblpatientexam.fldencounterval=tblencounter.fldencounterval  where tblencounter.fldpatientval=&1 and tblpatientexam.fldsave=&2 and tblpatientexam.fldhead=&3 and tblpatientsubexam.fldsubtexam=&4 and tblpatientexam.fldtime>=&5 and tblpatientexam.fldtime<=&6 ORDER BY tblpatientexam.fldtime", patNo, True, xColl["Examination"], xColl["Component"], xfir, xlast)
      If res1.Available Then
        res1.MoveLast
        If res1["fldreport"] Then
          xx = res1["fldreport"]
        Else
          xx = ""
        Endif
      Else
        xx = ""
      Endif

    Endif

  Else
    res1 = modDatabase.$myConn.Exec("select tblpatientexam.fldrepquali as fldrepquali,tblpatientexam.fldrepquanti as fldrepquanti from tblpatientexam inner join tblencounter on tblpatientexam.fldencounterval=tblencounter.fldencounterval  where tblencounter.fldpatientval=&1 and tblpatientexam.fldsave=&2 and tblpatientexam.fldhead=&3 and tblpatientexam.fldtime>=&4 and tblpatientexam.fldtime<=&5 ORDER BY tblpatientexam.fldtime", patNo, True, xColl["Examination"], xfir, xlast)
    If res1.Available Then
      res1.MoveLast
      If res1["fldrepquanti"] Then
        xx = CStr(res1["fldrepquanti"])
      Else
        xx = res1["fldrepquali"]
      Endif
    Else
      xx = ""
    Endif

  Endif

  Return xx

End

''====================== Chart ==========================
Public Sub btnshowchart_Click()

  LoadControls()

End

Private Function ChartHourVal() As Integer

  Dim xx As Integer

  If rboneday.Value = True Then
    xx = 24
  Else If rbtwoday.Value = True Then
    xx = 48
  Else If rbthreeday.Value = True Then
    xx = 72
  Else If rbweek.Value = True Then
    xx = 168
  Else
    xx = 0
  Endif

  Return xx

End

Private Sub LoadControls()

  Dim i As Integer

  If ListContainer1.Children.Count Then
    ListContainer1.DeleteChildren()
  Endif

  For i = 0 To $xParamVar.Count - 1
    aPanel[i] = New WebContainer(ListContainer1)
    aObHBox[i] = New WebContainer(aPanel[i])
    aObLef[i] = New WebContainer(aObHBox[i])
    aObj1[i] = New WebHtml(aObLef[i]) As "TextLabelGroup"

    aObRig[i] = New WebContainer(aObHBox[i])
    If $xParamVar[i]["Category"] = "Examination" Then
      If $xParamVar[i]["Type"] = "Quantitative" Then
        If $xalllow = True Then
          aObVal[i] = New WebValueBox(aObRig[i])
          If $input = True Then
            aObButt[i] = New WebButton(aObRig[i]) As "SaveButton"
          Endif
        Endif
        aObjx[i] = New WebScrollView(aPanel[i]) As "ScrollGroup"
        aObj[i] = New WebCanvas(aObjx[i]) As "PictureBoxgroup"

      Else
        If $xParamVar[i]["Component"] And If $xParamVar[i]["Option"] = "Clinical Scale" Then
          If $xalllow = True Then
            aObTxt[i] = New WebTextBox(aObRig[i])
            aObBtn[i] = New WebButton(aObRig[i]) As "ButtonBox"
            aObVal[i] = New WebValueBox(aObRig[i])
            If $input = True Then
              aObButt[i] = New WebButton(aObRig[i]) As "SaveButton"
            Endif
          Endif
          aObjx[i] = New WebScrollView(aPanel[i]) As "ScrollGroup"
          aObj[i] = New WebCanvas(aObjx[i]) As "PictureBoxgroup"

        Else  ''purely qualitative
          If $xalllow = True Then
            aObBox[i] = New WebComboBox(aObRig[i])
            If $input = True Then
              aObButt[i] = New WebButton(aObRig[i]) As "SaveButton"
            Endif
          Endif
          aObk[i] = New WebListBox(aPanel[i]) As "ListGroup"
        Endif
      Endif

    Else If $xParamVar[i]["Category"] = "Laboratory" Then
      If $xParamVar[i]["Type"] = "Quantitative" Then
        aObjx[i] = New WebScrollView(aPanel[i]) As "ScrollGroup"
        aObj[i] = New WebCanvas(aObjx[i]) As "PictureBoxgroup"
      Else
        aObk[i] = New WebListBox(aPanel[i]) As "ListGroup"
      Endif

    Else If $xParamVar[i]["Category"] = "Medicines" Then
      aObjx[i] = New WebScrollView(aPanel[i]) As "ScrollGroup"
      aObj[i] = New WebCanvas(aObjx[i]) As "PictureBoxgroup"

    Else If $xParamVar[i]["Category"] = "Intake" Then
      aObjx[i] = New WebScrollView(aPanel[i]) As "ScrollGroup"
      aObj[i] = New WebCanvas(aObjx[i]) As "PictureBoxgroup"

    Else If $xParamVar[i]["Category"] = "Output" Then
      aObjx[i] = New WebScrollView(aPanel[i]) As "ScrollGroup"
      aObj[i] = New WebCanvas(aObjx[i]) As "PictureBoxgroup"

    Endif

  Next

  FillCHartItems(CStr(Slider1.Value * 3) & "em")

End

Public Sub ButtonBox_Click()

  Dim j As Integer
  Dim xval As String[]

  j = Last.Tag
  xval = DualScaleValue($xParamVar[j]["Component"], Split($xParamVar[j]["OptionValues"], ";"))
  If xval Then
    aObTxt[j].Text = xval[1]
    aObVal[j].Value = CFloat(xval[0])
  Endif

End

Private Sub FillCHartItems(sHeight As String)

  Dim i As Integer
  Dim sPath As String

  $chartColl = New Collection
  For i = 0 To $xParamVar.Count - 1

    With aPanel[i]
      .Arrangement = Arrange.Vertical
    End With

    With aObHBox[i]
      .Arrangement = Arrange.Row
      .Border = True
      .Tag = $xParamVar[i]["Constant"]
    End With

    With aObLef[i]
      .Arrangement = Arrange.Horizontal
      .Class = "size-tablet  less-container-margin"
      .Tag = i
    End With
    With aObj1[i]
      .Font = "bold"
      If $xParamVar[i]["Component"] Then
        .Text = "<p><b>" & $xParamVar[i]["Component"] & " [" & $xParamVar[i]["Examination"] & "]" & "</b></p>"
      Else
        .Text = "<p><b>" & $xParamVar[i]["Examination"] & "</b></p>"
      Endif
      .Expand = True
      .Tag = i
    End With

    With aObRig[i]
      .Arrangement = Arrange.Horizontal
      .Class = "size-tablet  less-container-margin"
      .Tag = i
    End With
    If $xParamVar[i]["Category"] = "Examination" Then
      If $xParamVar[i]["Type"] = "Quantitative" Then
        ''input
        If $xalllow = True Then
          With aObVal[i]
            .Width = "6em"
            .Height = "2em"
            .Tag = i
          End With
          If $input = True Then
            With aObButt[i]
              .Width = "2em"
              .Height = "2em"
              .Image = "icon:/32/apply"
              .Enabled = True
              .Tag = i
            End With
          Endif
        Endif

        ''chart
        With aObjx[i]
          .Height = sHeight
          .Arrangement = Arrange.Vertical
          .Tag = i
        End With
        With aObj[i]
          .Height = sHeight
          .Tag = i
        End With
        If rballvisit.Value = True Then
          sPath = modClinSub.FillQuantiExamChartHistory(aObj[i].Name, $PatientNum, $xParamVar[i]["Examination"], ChartHourVal())
        Else
          sPath = modClinSub.FillQuantiExamChart(aObj[i].Name, $encid, $xParamVar[i]["Examination"], ChartHourVal())
        Endif
        If sPath Then
          $chartColl.Add(sPath, $xParamVar[i]["Examination"])
        Endif

      Else  ''quali exam
        If $xParamVar[i]["Component"] And If $xParamVar[i]["Option"] = "Clinical Scale" Then
          If $xalllow = True Then
            With aObTxt[i]
              .Height = "2em"
              .Expand = True
              .Tag = i
            End With
            With aObBtn[i]
              .Width = "2em"
              .Height = "2em"
              .Image = "icon:/32/add"
              .Tag = i
            End With
            With aObVal[i]
              .Width = "3em"
              .Height = "2em"
              .Enabled = False
              .Tag = i
            End With
            If $input = True Then
              With aObButt[i]
                .Width = "2em"
                .Height = "2em"
                .Image = "icon:/32/apply"
                .Enabled = True
                .Tag = i
              End With
            Endif
          Endif

          ''chart
          With aObjx[i]
            .Height = sHeight
            .Arrangement = Arrange.Vertical
            .Tag = i
          End With
          With aObj[i]
            .Height = sHeight
            .Tag = i
          End With
          If rballvisit.Value = True Then
            sPath = modClinSub.FillQuantiExamChartHistory(aObj[i].Name, $PatientNum, $xParamVar[i]["Component"] & " [" & $xParamVar[i]["Examination"] & "]", ChartHourVal())
          Else
            sPath = modClinSub.FillQuantiExamChart(aObj[i].Name, $encid, $xParamVar[i]["Component"] & " [" & $xParamVar[i]["Examination"] & "]", ChartHourVal())
          Endif
          If sPath Then
            $chartColl.Add(sPath, $xParamVar[i]["Component"] & " [" & $xParamVar[i]["Examination"] & "]")
          Endif

        Else ''purely qualitative
          ''input
          If $xalllow = True Then
            With aObBox[i]
              .Width = "12em"
              .Height = "2em"
              .ReadOnly = False
              .List = Split($xParamVar[i]["OptionValues"], ";")
              .Tag = i
            End With
            If $input = True Then
              With aObButt[i]
                .Width = "2em"
                .Height = "2em"
                .Image = "icon:/32/apply"
                .Enabled = True
                .Tag = i
              End With
            Endif
          Endif

          ''table
          With aObk[i]
            .List = modClinic.UniExamValueList($encid, $xParamVar[i]["Examination"])
            .Height = sHeight
            .Tag = i
          End With
        Endif

      Endif

    Else If $xParamVar[i]["Category"] = "Laboratory" Then
      If $xParamVar[i]["Type"] = "Quantitative" Then
        With aObjx[i]
          .Height = sHeight
          .Arrangement = Arrange.Vertical
          .Tag = i
        End With
        With aObj[i]
          .Height = sHeight
          .Tag = i
        End With
        If rballvisit.Value = True Then
          sPath = modLabSub.FillQuantiTestChartHistory(aObj[i].Name, $PatientNum, $xParamVar[i]["Examination"], $unt, ChartHourVal())
        Else
          sPath = modLabSub.FillQuantiTestChart(aObj[i].Name, $encid, $xParamVar[i]["Examination"], $unt, ChartHourVal())
        Endif
        If sPath Then
          $chartColl.Add(sPath, $xParamVar[i]["Examination"])
        Endif

      Else
        With aObk[i]
          .List = modClinic.UniExamValueList($encid, $xParamVar[i]["Examination"])
          .Height = sHeight
          .Tag = i
        End With

      Endif

    Else If $xParamVar[i]["Category"] = "Medicines" Then
    Else If $xParamVar[i]["Category"] = "Intake" Then
    Else If $xParamVar[i]["Category"] = "Output" Then

    Endif

  Next

  For Each sPath In $chartColl
    If sPath Then
      Me.Exec(sPath)
    Endif
  Next

End

Public Sub SaveButton_Click()

  Dim i As Integer
  Dim xcateg As String
  Dim sPath As String
  Dim xColl As Collection

  i = Last.Tag

  If $sTitle = "Essential Examinations" Then
    xcateg = "Essential Examinations"
  Else
    xcateg = "Physician Examinations"
  Endif
  If $xParamVar[i]["Component"] And If $xParamVar[i]["Option"] = "Clinical Scale" Then
    If aObTxt[i].Text And If aObVal[i].Value Then
      xColl = New Collection
      xColl.Add(aObVal[i].Value, $xParamVar[i]["Component"])
      modClinSub.AddClinicExam($encid, "", $xParamVar[i]["Component"] & " [" & $xParamVar[i]["Examination"] & "]", "Clinical Scale", JSON.Encode(xColl), aObVal[i].Value, False, xcateg, aObHBox[i].Tag, "Regular")
      aObButt[i].Enabled = False

      $chartColl.Remove($xParamVar[i]["Component"] & " [" & $xParamVar[i]["Examination"] & "]")
      sPath = modClinSub.FillQuantiExamChart(aObj[i].Name, $encid, $xParamVar[i]["Component"] & " [" & $xParamVar[i]["Examination"] & "]", ChartHourVal())
      If sPath Then
        Me.Exec(sPath)
        $chartColl.Add(sPath, $xParamVar[i]["Component"] & " [" & $xParamVar[i]["Examination"] & "]")
      Endif
      Me.Exec(Subst("Toastify({text: '&1', duration: &2}).showToast()", "Information saved", modBasic.$BalloonDelay))
    Endif

  Else
    If aObVal[i] And If aObVal[i].Value Then
      modClinSub.AddQuantiData($encid, "", $xParamVar[i]["Examination"], "", aObVal[i].Value, False, xcateg, aObHBox[i].Tag)
      aObButt[i].Enabled = False

      $chartColl.Remove($xParamVar[i]["Examination"])
      sPath = modClinSub.FillQuantiExamChart(aObj[i].Name, $encid, $xParamVar[i]["Examination"], ChartHourVal())
      If sPath Then
        Me.Exec(sPath)
        $chartColl.Add(sPath, $xParamVar[i]["Examination"])
      Endif
      Me.Exec(Subst("Toastify({text: '&1', duration: &2}).showToast()", "Information saved", modBasic.$BalloonDelay))

    Else If aObBox[i] And If aObBox[i].Text Then
      modClinSub.AddQualiData($encid, "", $xParamVar[i]["Examination"], "", aObBox[i].Text, False, xcateg, aObHBox[i].Tag)
      aObButt[i].Enabled = False

      aObk[i].List = modClinic.UniExamValueList($encid, $xParamVar[i]["Examination"])
      Me.Exec(Subst("Toastify({text: '&1', duration: &2}).showToast()", "Information saved", modBasic.$BalloonDelay))

    Endif
  Endif

End

