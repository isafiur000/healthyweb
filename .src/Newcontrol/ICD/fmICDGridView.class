' Gambas class file

Private $Conn As Connection
Private $sType As String
Private $dPanel As String

Private $rData As Result
Private $aMyFields As String[]
Private $ModelLst As String[]

Private $sValue As String[]

Public Sub Run(sConn As Connection, sType As String, sPanel As String) As String[]

  $Conn = sConn
  $sType = sType
  $dPanel = sPanel
  modGeneralMain.GetOpenModalForm(Me)
  chkleftmain.Value = modBasic.$SearchBothSide

  $ModelLst = modMLModels.GetAIModelsList("search_diagnosis")
  modSettings.ShowCheckBox(chkgroup, "ClinicForms/ICDGroups")
  modSettings.ShowCheckBox(chkboth, "ClinicForms/ICDBothCodes")

  $sValue = New String[]
  FillICDGrid()
  If modBasic.$TabletModeEnable = "Yes" Then
  Else
    txtname.SetFocus
  Endif

  If Me.ShowModal() Then Return $sValue

End

Public Sub chkboth_Click()

  modSettings.EnterCheckSetting(chkboth, "ClinicForms/ICDBothCodes")

End

Public Sub chkgroup_Click()

  modSettings.EnterCheckSetting(chkgroup, "ClinicForms/ICDGroups")

End

Public Sub chkleftmain_Click()

  modBasic.$SearchBothSide = chkleftmain.Value
  txtname.SetFocus

End

Public Sub FillICDGrid()

  Dim xstr As String
  Dim xgrp As String
  Dim xpanel As String
  Dim xpanel1 As String

  If chkboth.Value = True Then
    xstr = " and fldoldcode IS NOT NULL"
  Else
    xstr = ""
  Endif
  If chkgroup.Value = True Then
    xgrp = " and fldicdcode NOT LIKE &2"
  Else
    xgrp = ""
  Endif

  If $dPanel Then
    xpanel = db.Subst(" and fldscheme=&1", $dPanel)
    xpanel1 = db.Subst(" where fldscheme=&1", $dPanel)
  Else
    xpanel = ""
    xpanel1 = ""
  Endif

  If txtcode.Text Then
    $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where lower(fldicdcode) like &1" & xstr & xgrp & xpanel, LCase(txtcode.Text) & "%", "%.%")
  Else If txtname.Text Then
    If chkleftmain.Value = True Then
      $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where lower(fldicdnme) like &1" & xstr & xgrp & xpanel, "%" & LCase(txtname.Text) & "%", "%.%")
    Else
      $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where lower(fldicdnme) like &1" & xstr & xgrp & xpanel, LCase(txtname.Text) & "%", "%.%")
    Endif

  Else
    If chkgroup.Value = True Then
      If chkboth.Value = True Then
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where fldoldcode IS NOT NULL and fldicdcode NOT LIKE &1" & xpanel, "%.%")
      Else
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where fldicdcode NOT LIKE &1" & xpanel, "%.%")
      Endif
    Else
      If chkboth.Value = True Then
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where fldoldcode IS NOT NULL" & xpanel)
      Else
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease" & xpanel1)
      Endif
    Endif

  Endif
  $aMyFields = New String[]
  modGridView.ReadSmallData(GridView1, $rData, $aMyFields)
  ResizeGrid()

End

Private Sub ResizeGrid()

  With GridView1
    .Columns[0].Expand = True
    .Columns[1].Width = CStr(100 * modBasic.$AppWidthRatio) & "px"
    .Columns[2].Hidden = True

    .Columns[0].Text = "Particulars"
    .Columns[1].Text = "Code"
  End With

End

Public Sub GridView1_Data(Row As Integer, Column As Integer, Data As WebTableData)

  $rData.MoveTo(Row)
  modGridView.GridViewDecoration(Data, Row)
  Data.Text = $rData[$aMyFields[Column]]

End

Public Sub txtname_Change()

  txtcode.Text = ""
  If txtname.Text Then
    FillICDGrid()
  Endif

End

Public Sub txtcode_Change()

  txtname.Text = ""
  If txtcode.Text Then
    FillICDGrid()
  Endif

End

Public Sub txtname_Click()

  txtname.Text = ""
  FillICDGrid()

End

Public Sub btnok_Click()

  Dim xxx As String[]

  If GridView1.Selection.Count Then
    $rData.MoveTo(GridView1.Selection[0])
    xxx = New String[]
    xxx.Add($rData["fldicdnme"])
    xxx.Add($rData["fldicdcode"])
    xxx.Add($rData["fldoldcode"])
    $sValue = xxx
    Me.Close(True)
  Endif

End

Public Sub btnclose_Click()

  Me.Close()

End

''-------------------- Semantic Search ------------------
Public Sub chksemantic_Click()

  btnsemantic.Visible = chksemantic.Value

End

Public Sub btnsemantic_Click()

  Dim xstr As String
  Dim xpanel As String

  Dim strItem As String[]
  Dim i As Integer

  If chkboth.Value = True Then
    xstr = " and fldoldcode IS NOT NULL"
  Else
    xstr = ""
  Endif

  If $dPanel Then
    xpanel = db.Subst(" and fldscheme=&1", $dPanel)
  Else
    xpanel = ""
  Endif

  strItem = New String[]
  If $ModelLst.Count And If txtname.Text Then
    strItem = modClinModels.GetMatchingICDCodes($ModelLst[0], txtname.Text)
    If strItem And If strItem.Count Then

      If chkgroup.Value = True Then
        For i = 0 To strItem.Count - 1
          strItem[i] = "'" & strItem[i] & "'"
        Next
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where fldicdcode in(" & strItem.Join(",") & ")" & xstr & xpanel)
      Else
        For i = 0 To strItem.Count - 1
          strItem[i] = "fldicdcode LIKE '" & strItem[i] & "%'"
        Next
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where (" & strItem.Join(" OR ") & ")" & xstr & xpanel)
      Endif

      $aMyFields = New String[]
      modGridView.ReadSmallData(GridView1, $rData, $aMyFields)
      ResizeGrid()
    Endif
  Endif

End
