' Gambas class file

Static Public Sub _call(sConn As Connection, sType As String, sDefOPDGroup As String, sDefERGroup As String, Optional sPanel As String) As String[]                   ''

  If modBasic.$ClinDiagnosisGrid = "All" Then
    Return fmICDGridView.Run(sConn, sType, sPanel)
  Else If modBasic.$ClinDiagnosisGrid = "Specific" Then
    If sPanel Then
      Return fmICDGridView.Run(sConn, sType, sPanel)
    Else
      Return fmICDTreeList.Run(sConn, sType, sDefOPDGroup, sDefERGroup, sPanel)
    Endif
  Else
    Return fmICDTreeList.Run(sConn, sType, sDefOPDGroup, sDefERGroup, sPanel)
  Endif

End
