' Gambas class file

Private $sDevice As String
Private $sValue As String
Private $Path As String
Private $sKey As String

Public Sub Run(Optional sDevice As String) As String

  If sDevice Then
    $sDevice = sDevice
  Endif
  modGeneralMain.GetOpenModalForm(Me)
  $sKey = CreateServerKey()
  mnupload_Click()
  WebForm._AddJavascript("videokey = " & JS($sKey) & ";")

  If Me.ShowModal() Then Return $sValue

End

Public Sub mnupload_Click()

  Dim sfile As String

  sfile = File.Load("jv/VideoRecord.js")
  Me.Exec(sfile)

End

Private Function CreateServerKey() As String

  Dim I As Integer
  Dim sKey As String
  Dim sPath As String

  $Path = File.Dir(File.Dir(Temp())) &/ "upload"
  Try Mkdir $Path

  For I = 1 To 4
    sKey &= Hex$(Rand(0, 65535), 4)
  Next

  sPath = $Path &/ sKey
  Try Kill sPath
  File.Save(sPath, "")

  Return sKey

End

Public Sub btnclose_Click()

  If Exist($Path &/ $sKey) Then
    $sValue = $Path &/ $sKey
    Me.Close(True)
  Else
    Me.Close()
  Endif

End
