# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,90,64)
  Class = "widesize-popupform"
  Arrangement = Arrange.Vertical
  Title = ("Screen Drawing")
  { WebMenu1 WebMenu
    Visible = False
    Text = ("WebMenu1")
    { mnudraw WebMenu
      Text = ("Draw")
    }
    { mnuimage WebMenu
      Text = ("Background")
    }
  }
  { WebContainer4 WebContainer
    #MoveScaled(1,1,88,6)
    Arrangement = Arrange.Row
    { WebContainer1 WebContainer
      #MoveScaled(1,1,46,4)
      Class = "size-tablet  less-container-margin"
      Arrangement = Arrange.Horizontal
      { cmbimage WebComboBox
        #MoveScaled(1,1,13,2)
        Width = "12em"
        Height = "2em"
        ReadOnly = False
      }
      { WebContainer5 WebContainer
        #MoveScaled(14,1,6,2)
        Expand = True
      }
      { btndownload WebButton
        #MoveScaled(20,1,9,2)
        Width = "7em"
        Height = "2em"
        Text = ("Down")
        Image = "icon:/32/down"
      }
      { btnsend WebButton
        #MoveScaled(29,1,6,2)
        Width = "7em"
        Height = "2em"
        Text = ("Save")
        Image = "icon:/32/apply"
      }
    }
    { WebContainer6 WebContainer
      #MoveScaled(47,1,37,4)
      Class = "size-tablet  less-container-margin"
      Arrangement = Arrange.Horizontal
      { btnclear WebButton
        #MoveScaled(1,1,5,2)
        Width = "2em"
        Height = "2em"
        Image = "icon:/small/clear"
      }
      { WebContainer3 WebContainer
        #MoveScaled(6,1,5,2)
        Width = "4em"
      }
      { WebButtonBox1 WebButtonBox
        #MoveScaled(11,1,11,2)
        Height = "2em"
        Expand = True
      }
      { btnclose WebButton
        #MoveScaled(22,1,11,2)
        Width = "6em"
        Height = "2em"
        Text = ("Close")
      }
    }
  }
  { WebContainer2 WebContainer
    #MoveScaled(1,7,88,44)
    Height = "50vh"
    Border = True
  }
}
