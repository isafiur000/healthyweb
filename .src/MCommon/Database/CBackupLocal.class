  Return sTargFile

End

Private Function GetMyDumpNormalMulti() As String

  Dim sTargFile As String
  Dim xTable As String
  Dim xx As String

  sTargFile = $Folder &/ $DBName & modString.GetNowString()
  If Exist(sTargFile) = False Then
    Mkdir sTargFile
  Endif
  For Each xTable In $TabList
    xx = "mysqldump --quick --single-transaction --complete-insert --skip-extended-insert --skip-triggers" & " -B " & $DBName & " --host " & $DBHost & " -u " & $DBUser & " -p" & $DBPass & " --tables " & xTable & " > " & sTargFile &/ xTable & ".sql"
    modBasic.DebugString("Execute " & Replace(xx, $DBPass, "***"))
    Shell xx Wait
  Next

  Return sTargFile

End
