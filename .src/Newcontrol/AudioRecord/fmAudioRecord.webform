# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,84,91)
  Arrangement = Arrange.Vertical
  Margin = True
  Title = ("Audio Recording")
  { WebMenu1 WebMenu
    Visible = False
    { WebMenu2 WebMenu
      Text = ("WebMenu2")
    }
  }
  { WebContainer3 WebContainer
    #MoveScaled(1,1,82,47)
    Class = "size-popupform "
    Arrangement = Arrange.Vertical
    { WebContainer1 WebContainer
      #MoveScaled(1,1,80,7)
      Class = "less-container-margin"
      Arrangement = Arrange.Horizontal
      Spacing = True
      { btnstart WebButton
        #MoveScaled(1,1,13,5)
        Class = "record-btn"
        Width = "9em"
        Height = "2em"
        Text = ("Start")
        Image = "icon:/32/play"
      }
      { btnstop WebButton
        #MoveScaled(15,1,13,5)
        Class = "stop-btn"
        Width = "9em"
        Height = "2em"
        Text = ("Stop")
        Image = "icon:/32/stop"
      }
      { WebContainer4 WebContainer
        #MoveScaled(29,1,10,5)
        Expand = True
      }
      { btnsave WebButton
        #MoveScaled(40,1,15,5)
        Class = "upload-btn"
        Width = "9em"
        Height = "2em"
        Text = ("Save")
        Image = "icon:/32/upload"
      }
      { btnclose WebButton
        #MoveScaled(56,1,15,5)
        Width = "6em"
        Height = "2em"
        Text = ("Close")
      }
    }
    { WebContainer2 WebContainer
      #MoveScaled(1,8,80,6)
      Height = "2em"
      Arrangement = Arrange.Horizontal
      Spacing = True
      { WebAudioPanel1 WebAudioPanel
        #MoveScaled(1,1,34,4)
        Class = "audio-preview"
        Height = "2em"
        Expand = True
      }
    }
    { WebTextArea1 WebTextArea
      #MoveScaled(1,14,80,18)
      Class = "height-tablet-verylow"
      Wrap = True
    }
    { WebContainer5 WebContainer
      #MoveScaled(1,32,80,3)
      Class = "audio-status"
      Height = "1em"
    }
  }
}
