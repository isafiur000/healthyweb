# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,80,37)
  Class = "widesize-popupform"
  Arrangement = Arrange.Vertical
  Margin = True
  Title = ("Webcam Image")
  { WebMenu1 WebMenu
    Visible = False
    { mnuload WebMenu
      Text = ("WebMenu2")
    }
  }
  { WebContainer1 WebContainer
    #MoveScaled(1,1,78,32)
    Class = "height-tablet"
    Arrangement = Arrange.Row
    { WebContainer3 WebContainer
      #MoveScaled(1,1,36,30)
      Class = "size-tablet"
      Arrangement = Arrange.Vertical
      Border = True
      { WebContainer4 WebContainer
        #MoveScaled(1,1,34,4)
        Class = "less-container-margin"
        Arrangement = Arrange.Horizontal
        { btnstart WebButton
          #MoveScaled(1,1,9,2)
          Class = "startBtn"
          Width = "30%"
          Height = "2em"
          Text = ("Start")
        }
        { btnstop WebButton
          #MoveScaled(10,1,9,2)
          Class = "stopBtn"
          Width = "30%"
          Height = "2em"
          Text = ("Stop")
        }
        { btndown WebButton
          #MoveScaled(19,1,9,2)
          Class = "downloadBtn"
          Width = "30%"
          Height = "2em"
          Text = ("Down")
        }
      }
      { WebContainer5 WebContainer
        #MoveScaled(1,5,34,4)
        Class = "less-container-margin"
        Arrangement = Arrange.Horizontal
        { btncapture WebButton
          #MoveScaled(1,1,9,2)
          Class = "captureBtn"
          Width = "30%"
          Height = "2em"
          Text = ("Capture")
        }
        { btnsave WebButton
          #MoveScaled(10,1,9,2)
          Class = "uploadBtn"
          Width = "30%"
          Height = "2em"
          Text = ("Save")
        }
        { btnclose WebButton
          #MoveScaled(19,1,10,2)
          Width = "30%"
          Height = "2em"
          Text = ("Close")
          Image = "icon:/32/close"
        }
      }
      { webCamImage1 webCamImage
        #MoveScaled(1,9,34,13)
        Class = "snapshot"
        Expand = True
      }
      { WebHtml1 WebHtml
        #MoveScaled(1,22,34,3)
        Class = "status"
        Height = "2em"
      }
    }
    { WebContainer2 WebContainer
      #MoveScaled(37,1,32,30)
      Class = "size-tablet"
      Arrangement = Arrange.Vertical
      Border = True
      { WebRecVideo1 WebRecVideo
        #MoveScaled(1,1,30,18)
        Class = "preview"
        Expand = True
        State = "autoplay muted playsinline"
      }
    }
  }
}
