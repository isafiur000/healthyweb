# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,86,49)
  Class = "size-popupform"
  Arrangement = Arrange.Vertical
  Margin = True
  Title = ("ICD Database")
  { WebContainer1 WebContainer
    #MoveScaled(1,1,84,5)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { chkleftmain WebCheckBox
      #MoveScaled(1,1,5,3)
      Height = "2em"
    }
    { txtname WebTextBox
      #MoveScaled(6,1,20,3)
      Width = "10em"
      Height = "2em"
      ShowClear = True
    }
    { btnsemantic WebButton
      #MoveScaled(26,1,3,3)
      Width = "3em"
      Height = "2em"
      Visible = False
      Image = "icon:/32/right"
    }
    { WebContainer7 WebContainer
      #MoveScaled(29,1,4,3)
      Expand = True
    }
    { btnok WebButton
      #MoveScaled(33,1,12,3)
      Width = "6em"
      Height = "2em"
      Text = ("Select")
      Image = "icon:/32/apply"
      Default = True
    }
    { btnclose WebButton
      #MoveScaled(45,1,8,3)
      Width = "5em"
      Height = "2em"
      Text = ("Close")
      Cancel = True
    }
    { WebContainer3 WebContainer
      #MoveScaled(53,1,6,3)
      Expand = True
    }
    { txtcode WebTextBox
      #MoveScaled(59,1,9,3)
      Width = "6em"
      Height = "2em"
    }
  }
  { WebContainer2 WebContainer
    #MoveScaled(1,6,84,33.875)
    Height = "50vh"
    Expand = True
    Arrangement = Arrange.Horizontal
    { GridView1 WebTable
      #MoveScaled(1,1,41,31.875)
      Expand = True
      Mode = Select.Single
      ShowCheck = False
    }
  }
  { WebContainer4 WebContainer
    #MoveScaled(1,39.875,84,4)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { chkboth WebCheckBox
      #MoveScaled(1,1,21,2)
      Height = "2em"
      Text = ("Both Coding")
    }
    { WebContainer5 WebContainer
      #MoveScaled(22,1,5,2)
      Expand = True
    }
    { chkgroup WebCheckBox
      #MoveScaled(27,1,14,2)
      Height = "2em"
      Text = ("Groups Only")
    }
    { WebContainer6 WebContainer
      #MoveScaled(41,1,5,2)
      Expand = True
    }
    { chksemantic WebCheckBox
      #MoveScaled(46,1,14,2)
      Height = "2em"
      Text = ("Semantic Search")
    }
  }
}
