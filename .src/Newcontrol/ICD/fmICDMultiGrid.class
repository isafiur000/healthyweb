' Gambas class file

Private $Conn As Connection
Private $sType As String

Private $rData As Result
Private $aMyFields As String[]
Private $ModelLst As String[]

Private $sValue As Variant[]

Public Sub Run(sConn As Connection, sType As String) As Variant[]

  $Conn = sConn
  $sType = sType
  modGeneralMain.GetOpenModalForm(Me)
  chkleftmain.Value = modBasic.$SearchBothSide

  $ModelLst = modMLModels.GetAIModelsList("search_diagnosis")
  modSettings.ShowCheckBox(chkgroup, "ClinicForms/ICDGroups")

  $sValue = New Variant[]
  FillICDGrid()
  If modBasic.$TabletModeEnable = "Yes" Then
  Else
    txtname.SetFocus
  Endif

  If Me.ShowModal() Then Return $sValue

End

Public Sub chkgroup_Click()

  modSettings.EnterCheckSetting(chkgroup, "ClinicForms/ICDGroups")

End

Public Sub chkleftmain_Click()

  modBasic.$SearchBothSide = chkleftmain.Value
  txtname.SetFocus

End

Public Sub FillICDGrid()

  Dim xstr As String
  Dim xgrp As String

  If chkboth.Value = True Then
    xstr = " and fldoldcode IS NOT NULL"
  Else
    xstr = ""
  Endif
  If chkgroup.Value = True Then
    xgrp = " and fldicdcode NOT LIKE &2"
  Else
    xgrp = ""
  Endif

  If txtcode.Text Then
    $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where lower(fldicdcode) like &1" & xstr & xgrp, LCase(txtcode.Text) & "%", "%.%")
  Else If txtname.Text Then
    If chkleftmain.Value = True Then
      $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where lower(fldicdnme) like &1" & xstr & xgrp, "%" & LCase(txtname.Text) & "%", "%.%")
    Else
      $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where lower(fldicdnme) like &1" & xstr & xgrp, LCase(txtname.Text) & "%", "%.%")
    Endif

  Else
    If chkgroup.Value = True Then
      If chkboth.Value = True Then
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where fldoldcode IS NOT NULL and fldicdcode NOT LIKE &1", "%.%")
      Else
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where fldicdcode NOT LIKE &1", "%.%")
      Endif
    Else
      If chkboth.Value = True Then
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where fldoldcode IS NOT NULL")
      Else
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease")
      Endif
    Endif

  Endif
  $aMyFields = New String[]
  modGridView.ReadSmallData(GridView1, $rData, $aMyFields)
  ResizeGrid()

End

Private Sub ResizeGrid()

  With GridView1
    .Columns[0].Expand = True
    .Columns[1].Width = CStr(100 * modBasic.$AppWidthRatio) & "px"
    .Columns[2].Hidden = True

    .Columns[0].Text = "Particulars"
    .Columns[1].Text = "Code"
  End With

End

Public Sub GridView1_Data(Row As Integer, Column As Integer, Data As WebTableData)

  $rData.MoveTo(Row)
  modGridView.GridViewDecoration(Data, Row)
  Data.Text = $rData[$aMyFields[Column]]

End

Public Sub txtname_Change()

  txtcode.Text = ""
  If txtname.Text Then
    FillICDGrid()
  Endif

End

Public Sub txtcode_Change()

  txtname.Text = ""
  If txtcode.Text Then
    FillICDGrid()
  Endif

End

Public Sub txtname_Click()

  txtname.Text = ""
  FillICDGrid()

End

Public Sub btninsert_Click()

  Dim Row As Integer
  Dim xxx As String[]

  For Row = 0 To GridView1.Count - 1
    If GridView1.IsSelected(Row) = True Then
      $rData.MoveTo(Row)
      xxx = New String[]
      xxx.Add($rData["fldicdnme"])
      xxx.Add($rData["fldicdcode"])
      xxx.Add($rData["fldoldcode"])
      $sValue.Add(xxx)
    Endif
  Next
  Me.Exec(Subst("Toastify({text: '&1', duration: &2}).showToast()", "Information saved", modBasic.$BalloonDelay))

End

Public Sub btnok_Click()

  Me.Close(True)

End

Public Sub btnclose_Click()

  Me.Close()

End

Public Sub chkall_Click()

  If chkall.Value = True Then
    GridView1.SelectAll()
  Else If chkall.Value = False Then
    GridView1.UnselectAll()
  Endif

End

''-------------------- Semantic Search ------------------
Public Sub chksemantic_Click()

  btnsemantic.Visible = chksemantic.Value

End

Public Sub btnsemantic_Click()

  Dim xstr As String
  Dim strItem As String[]
  Dim i As Integer

  If chkboth.Value = True Then
    xstr = " and fldoldcode IS NOT NULL"
  Else
    xstr = ""
  Endif

  strItem = New String[]
  If $ModelLst.Count And If txtname.Text Then
    strItem = modClinModels.GetMatchingICDCodes($ModelLst[0], txtname.Text)
    If strItem And If strItem.Count Then

      If chkgroup.Value = True Then
        For i = 0 To strItem.Count - 1
          strItem[i] = "'" & strItem[i] & "'"
        Next
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where fldicdcode in(" & strItem.Join(",") & ")")
      Else
        For i = 0 To strItem.Count - 1
          strItem[i] = "fldicdcode LIKE '" & strItem[i] & "%'"
        Next
        $rData = $Conn.Exec("select fldicdnme,fldicdcode,fldoldcode from tblicddisease where (" & strItem.Join(" OR ") & ")")
      Endif

      $aMyFields = New String[]
      modGridView.ReadSmallData(GridView1, $rData, $aMyFields)
      ResizeGrid()
    Endif
  Endif

End
