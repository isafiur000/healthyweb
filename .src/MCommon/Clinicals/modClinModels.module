' Gambas module file

Public Function GetDiagnosisMatch(xModel As String, sName As String, xgroup As String) As Float

  Dim xout As Variant
  Dim xper As Float

  If sName = xgroup Then
    xout = 100
  Else
    xout = Trim(modMLModels.GeAItModelValueArguments(xModel, [sName, xgroup]))
    If xout Then
      xper = Round(CFloat(xout) * 100, -2)
    Else
      xper = 0
    Endif
  Endif

  Return xper

End

Public Function GetMatchingICDCodes(xModel As String, xinput As String) As String[]

  Dim xout As String
  Dim xList As String[]

  Dim asx As String[]
  Dim bsx As String[]
  Dim Row As Integer
  Dim sCode As String

  xList = New String[]
  If xinput And If xModel Then
    xout = Trim(modMLModels.GeAItModelValueArguments(xModel, [xinput]))
    If xout Then

      asx = Split(xout, gb.NewLine)
      For Row = 0 To asx.Count - 1
        bsx = Split(asx[Row], ":")
        If bsx.Count = 3 Then
          sCode = ""
          sCode = Trim(Replace(bsx[1], "Score", ""))
          If sCode Then
            xList.Add(sCode)
          Endif
        Endif
      Next

    Endif
  Endif

  Return xList

End
