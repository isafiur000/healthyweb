' Gambas class file

Private $rData1 As Result
Private $aMyFields1 As String[]
Private $sType As String

Public Sub _new(sType As String)

  $sType = sType
  FillReportData(modBasic.$lbluser)

End

Public Sub WebForm_Open()

  modGeneralMain.RecordFormUse(Me)

End

''====================== Archived REPORTS =========================
Private Sub FillReportData(patno As String)

  Dim encLst As String[]
  Dim k As Integer

  If modPatPortal.$UserMode = "PatientID" Then
    encLst = modPatient.GetEncListFromPatNo(patno, modDatabase.$syConn)
    For k = 0 To encLst.Count - 1
      encLst[k] = "'" & encLst[k] & "'"
    Next

    If $sType = "test" Then
      $rData1 = modDatabase.$logConn.Exec("select fldid,fldcateg,fldtime,fldencounterval,fldencounterval,fldtitle,fldid,flddetail,fldsave,fldlink from tblpatreport where fldencounterval in(" & encLst.Join(",") & ") and fldcateg=&1 and (flvisible=&2 or flvisible IS NULL) ORDER BY fldid DESC", "Diagnostic Tests", "Visible")                                                                 ''
    Else If $sType = "radio" Then
      $rData1 = modDatabase.$logConn.Exec("select fldid,fldcateg,fldtime,fldencounterval,fldencounterval,fldtitle,fldid,flddetail,fldsave,fldlink from tblpatreport where fldencounterval in(" & encLst.Join(",") & ") and fldcateg=&1 and (flvisible=&2 or flvisible IS NULL) ORDER BY fldid DESC", "Radio Diagnostics", "Visible")
    Else If $sType = "general" Then
      $rData1 = modDatabase.$logConn.Exec("select fldid,fldcateg,fldtime,fldencounterval,fldencounterval,fldtitle,fldid,flddetail,fldsave,fldlink from tblpatreport where fldencounterval in(" & encLst.Join(",") & ") and fldcateg=&1 and (flvisible=&2 or flvisible IS NULL) ORDER BY fldid DESC", "General Reports", "Visible")
    Else If $sType = "all" Then
      $rData1 = modDatabase.$logConn.Exec("select fldid,fldcateg,fldtime,fldencounterval,fldencounterval,fldtitle,fldid,flddetail,fldsave,fldlink from tblpatreport where fldencounterval in(" & encLst.Join(",") & ") and (fldcateg=&1 or fldcateg=&2 or fldcateg=&3) and (flvisible=&4 or flvisible IS NULL) ORDER BY fldid DESC", "Diagnostic Tests", "Radio Diagnostics", "General Reports", "Visible")
    Endif

  Else If modPatPortal.$UserMode = "Encounter" Then
    If $sType = "test" Then
      $rData1 = modDatabase.$logConn.Exec("select fldid,fldcateg,fldtime,fldencounterval,fldencounterval,fldtitle,fldid,flddetail,fldsave,fldlink from tblpatreport where fldencounterval=&1 and fldcateg=&2 and (flvisible=&3 or flvisible IS NULL) ORDER BY fldid DESC", patno, "Diagnostic Tests", "Visible")                                                                 ''
    Else If $sType = "radio" Then
      $rData1 = modDatabase.$logConn.Exec("select fldid,fldcateg,fldtime,fldencounterval,fldencounterval,fldtitle,fldid,flddetail,fldsave,fldlink from tblpatreport where fldencounterval=&1 and fldcateg=&2 and (flvisible=&3 or flvisible IS NULL) ORDER BY fldid DESC", patno, "Radio Diagnostics", "Visible")
    Else If $sType = "general" Then
      $rData1 = modDatabase.$logConn.Exec("select fldid,fldcateg,fldtime,fldencounterval,fldencounterval,fldtitle,fldid,flddetail,fldsave,fldlink from tblpatreport where fldencounterval=&1 and fldcateg=&2 and (flvisible=&3 or flvisible IS NULL) ORDER BY fldid DESC", patno, "General Reports", "Visible")
    Else If $sType = "all" Then
      $rData1 = modDatabase.$logConn.Exec("select fldid,fldcateg,fldtime,fldencounterval,fldencounterval,fldtitle,fldid,flddetail,fldsave,fldlink from tblpatreport where fldencounterval=&1 and (fldcateg=&2 or fldcateg=&3 or fldcateg=&4) and (flvisible=&5 or flvisible IS NULL) ORDER BY fldid DESC", patno, "Diagnostic Tests", "Radio Diagnostics", "General Reports", "Visible")
    Endif

  Endif
  $aMyFields1 = New String[]
  modGridView.ReadSmallData(GridView1, $rData1, $aMyFields1)

  With GridView1
    .Columns[0].Hidden = True
    .Columns[1].Width = CStr(150 * modBasic.$AppWidthRatio) & "px"
    .Columns[2].Width = CStr(150 * modBasic.$AppWidthRatio) & "px"
    .Columns[3].Hidden = True
    .Columns[4].Hidden = True
    .Columns[5].Width = CStr(150 * modBasic.$AppWidthRatio) & "px"
    .Columns[6].Hidden = True
    .Columns[7].Width = CStr(175 * modBasic.$AppWidthRatio) & "px"
    .Columns[8].Hidden = True
    .Columns[9].Hidden = True

    .Columns[1].Text = "Category"
    .Columns[2].Text = "DateTime"
    .Columns[5].Text = "Title"
    .Columns[7].Text = "Comment"
  End With

End

Public Sub GridView1_Data(Row As Integer, Column As Integer, Data As WebTableData)

  $rData1.MoveTo(Row)
  modGridView.GridViewDecoration(Data, Row)
  If Column = 2 Then
    Data.Text = modReportVar.GetDateTimeReport($rData1[$aMyFields1[Column]], gb.GeneralDate)
  Else
    Data.Text = $rData1[$aMyFields1[Column]]
  Endif

End

Public Sub mnushow_Click()

  Dim xLink As String

  If GridView1.Selection.Count Then
    $rData1.MoveTo(GridView1.Selection[0])

    xLink = modImage.GetBlobFileData($rData1["fldid"])
    If xLink Then
      WebPDFView1.Viewer = modSettings.ShowSettingFromFIle("Application/PDFViewer")
      WebPDFView1.Tag = modPrint.GetFileWebURL(xLink)
      WebPDFView1.Path = WebPDFView1.Tag
    Endif

  Endif

End

Public Sub mnuprint_Click()

  Dim xLink As String

  If GridView1.Selection.Count Then
    $rData1.MoveTo(GridView1.Selection[0])

    xLink = modImage.GetBlobFileData($rData1["fldid"])
    If xLink Then
      Me.Exec("printJS('" & modPrint.GetFileWebURL(xLink) & "')")
    Endif

  Endif

End
