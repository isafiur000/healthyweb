# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,64,64)
  Class = "halfsize-popupform"
  Arrangement = Arrange.Vertical
  Margin = True
  Title = ("Webcam Video")
  { WebMenu1 WebMenu
    Visible = False
    { mnupload WebMenu
      Text = ("Upload")
    }
  }
  { WebContainer7 WebContainer
    #MoveScaled(1,1,62,4)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { btnStart WebButton
      #MoveScaled(1,1,12,2)
      Class = "startBtn"
      Width = "7em"
      Height = "2em"
      Text = ("Start")
    }
    { btnRecord WebButton
      #MoveScaled(13,1,14,2)
      Class = "recordBtn"
      Height = "2em"
      Expand = True
      Text = ("Start Recording")
    }
    { btnDown WebButton
      #MoveScaled(27,1,10,2)
      Class = "downloadBtn"
      Width = "7em"
      Height = "2em"
      Text = ("Down")
    }
  }
  { WebContainer8 WebContainer
    #MoveScaled(1,5,62,4)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { WebHtml1 WebHtml
      #MoveScaled(1,1,18,2)
      Class = "statusBar"
      Height = "2em"
      Expand = True
    }
    { btnupload WebButton
      #MoveScaled(19,1,8,2)
      Class = "uploadBtn"
      Width = "7em"
      Height = "2em"
      Expand = True
      Text = ("Save")
    }
    { btnclose WebButton
      #MoveScaled(27,1,10,2)
      Width = "5em"
      Height = "2em"
      Text = ("Close")
    }
  }
  { WebContainer3 WebContainer
    #MoveScaled(1,9,62,28)
    Arrangement = Arrange.Vertical
    Border = True
    { sGumVideo WebRecVideo
      #MoveScaled(1,1,60,18)
      Class = "preview"
      State = "playsinline autoplay muted"
    }
  }
  { WebContainer2 WebContainer
    #MoveScaled(1,37,62,24)
    Arrangement = Arrange.Vertical
    Border = True
    { sRecVideo WebRecVideo
      #MoveScaled(1,1,60,13)
      Class = "playback"
      State = "playsinline  controls"
    }
  }
}
