# Gambas Form File 3.0

{ WebForm WebForm
  #MoveScaled(0,0,64,42)
  Class = "halfsize-popupform "
  Arrangement = Arrange.Vertical
  Margin = True
  { txtmedicine WebHtml
    #MoveScaled(1,1,62,5)
  }
  { WebContainer1 WebContainer
    #MoveScaled(1,6,62,5)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { WebLabel1 WebLabel
      #MoveScaled(1,1,22,3)
      Height = "2em"
      Expand = True
      Text = ("Volume Infused (mL)")
      Border = True
    }
    { txtinfuse WebValueBox
      #MoveScaled(23,1,13,3)
      Width = "6em"
      Height = "2em"
    }
    { WebContainer4 WebContainer
      #MoveScaled(36,1,11,3)
      Width = "4em"
    }
  }
  { WebContainer2 WebContainer
    #MoveScaled(1,11,62,5)
    Class = "less-container-margin"
    Arrangement = Arrange.Horizontal
    { WebLabel2 WebLabel
      #MoveScaled(1,1,22,3)
      Height = "2em"
      Expand = True
      Text = ("Volume Discarded (mL)")
      Border = True
    }
    { txtdiscard WebValueBox
      #MoveScaled(23,1,13,3)
      Width = "6em"
      Height = "2em"
    }
    { WebContainer5 WebContainer
      #MoveScaled(36,1,11,3)
      Width = "4em"
    }
  }
  { WebContainer3 WebContainer
    #MoveScaled(1,16,62,5)
    Class = "less-container-margin"
