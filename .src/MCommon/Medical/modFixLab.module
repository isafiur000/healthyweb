Public Function GetLabTestOrder(sTest As String, Optional sCon As Connection) As Integer

  Dim res As Result
  Dim xvar As Variant
  Dim xorder As Integer
  Dim $con As Connection

  If sCon Then
    $con = sCon
  Else
    $con = modDatabase.$medConn
  Endif

  If modTableCache.$TestMastereData.Exist(sTest) Then
    xvar = modTableCache.$TestMastereData[sTest]["fldtestorder"]
    If xvar Then
      xorder = CInt(xvar)
    Else
      xorder = 0
    Endif

  Else
    res = $con.Exec("select fldtestorder from tbltest where fldtestid=&1", sTest)
    If res.Available Then
      If res["fldtestorder"] Then
        xorder = res["fldtestorder"]
      Else
        xorder = 0
      Endif
    Else
      xorder = 0
    Endif
  Endif
  Return xorder

End

